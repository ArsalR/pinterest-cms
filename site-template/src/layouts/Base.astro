---
// Base layout — zero client JS (P1), system font stack (P4), critical CSS
// inlined by Astro (P5), semantic HTML + JSON-LD (K8/AEO).
import { loadConfig, canonicalHost, fetchSeoSettings, globalSchemaFor, scriptTagsFor } from "../lib/cms"
import { presetRootCss, resolvePreset } from "../lib/presets"

interface Props {
  title: string
  description: string
  path: string             // e.g. "/posts/my-post/"
  schema?: object | null   // page-specific JSON-LD
  ogType?: string          // "website" | "article" | "product"
  ogImage?: string | null  // absolute URL of the social image
  // V1.2 SEO cockpit overrides. All optional — absent = byte-identical output.
  robots?: string | null            // e.g. "noindex, nofollow"; absent = no robots meta
  canonicalOverride?: string | null // absolute URL; absent = computed canonical
  ogTitle?: string | null           // absent = title
  ogDescription?: string | null     // absent = description
}

const {
  title, description, path, schema = null, ogType = "website", ogImage = null,
  robots = null, canonicalOverride = null, ogTitle = null, ogDescription = null,
} = Astro.props
const config = loadConfig()
const host = canonicalHost(config)
const canonical = canonicalOverride ?? `https://${host}${path}`
const socialTitle = ogTitle ?? title
const socialDescription = ogDescription ?? description
// Global Organization/WebSite schema (S3) — null (no output) unless the site
// owner enabled it in the SEO Control Center. Byte-identical when off.
const seoSettings = await fetchSeoSettings(config)
const globalLd = globalSchemaFor(seoSettings, config.name, `https://${host}`)
// Vetted site scripts (V1.3): "" when none enabled — byte-identical zero-JS.
const siteScriptTags = scriptTagsFor(seoSettings)
const year = new Date().getFullYear()
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={config.name} href="/rss.xml" />

  {/* Favicon + PWA manifest (SEO file set, amendment 3). SVG favicon covers
      modern browsers; genesis adds branded .ico/apple-touch PNGs per niche. */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content={resolvePreset(config.preset).accent} />

  {/* Open Graph + Twitter (social + AI-answer surfaces). */}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={config.name} />
  <meta property="og:title" content={socialTitle} />
  <meta property="og:description" content={socialDescription} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={socialTitle} />
  <meta name="twitter:description" content={socialDescription} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  {globalLd && <script type="application/ld+json" set:html={JSON.stringify(globalLd)} />}
  {siteScriptTags && <Fragment set:html={siteScriptTags} />}
  <style set:html={`
    /* Design system (D1) — CSS variables + a lean content stylesheet. Zero JS
       (P1); system fonts in D1, curated faces in D2 (P4); CSS stays well under
       budget (P5). Tokens drive type scale, spacing, elevation and components. */
    ${presetRootCss(config.preset)}
    *,*::before,*::after { box-sizing:border-box; }
    html { -webkit-text-size-adjust:100%; }
    body { margin:0; font-family:var(--font-body); color:var(--fg); background:var(--bg);
      font-size:var(--fs-base); line-height:var(--lh-body);
      -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
      font-feature-settings:"kern","liga"; }
    ::selection { background:var(--accent-soft); }
    header, main, footer { max-width:var(--maxw); margin-inline:auto; padding-inline:1.25rem; }
    header { max-width:var(--wide); padding-top:1.6rem; padding-bottom:1.1rem; gap:1rem; }
    header a.brand { font-family:var(--font-head); font-weight:var(--fw-head); font-size:1.2rem;
      letter-spacing:var(--ls-head); color:var(--fg); text-decoration:none; }
    main { padding-bottom:var(--sp-16); }

    h1,h2,h3,h4 { font-family:var(--font-head); font-weight:var(--fw-head);
      letter-spacing:var(--ls-head); line-height:1.14; text-wrap:balance; margin:0 0 .6em; }
    h1 { font-size:var(--fs-h1); line-height:1.07; }
    h2 { font-size:var(--fs-h2); margin-top:1.8em; }
    h3 { font-size:var(--fs-h3); margin-top:1.5em; }
    h4 { font-size:var(--fs-h4); margin-top:1.3em; }

    p,ul,ol,blockquote,table,pre { margin:0 0 1.15em; }
    p { max-width:68ch; }
    a { color:var(--accent); text-decoration-thickness:1.5px; text-underline-offset:2px;
      text-decoration-color:var(--accent-line); }
    a:hover { text-decoration-color:var(--accent); }
    small,.meta { font-size:var(--fs-sm); color:var(--muted); }
    strong { font-weight:660; }
    .lead { font-size:var(--fs-md); color:var(--muted); }

    ul,ol { padding-left:1.3em; } li { margin:.3em 0; }
    ul li::marker { color:var(--accent); }
    blockquote { margin-inline:0; padding:.35em 0 .35em 1.1em; border-left:3px solid var(--accent);
      color:var(--muted); font-size:var(--fs-md); } blockquote p { max-width:none; }
    hr { border:0; height:1px; background:var(--border); margin:var(--sp-12) 0; }

    img { max-width:100%; height:auto; border-radius:calc(var(--radius) + 2px); }
    figure { margin:1.6em 0; } figcaption { font-size:var(--fs-sm); color:var(--muted); margin-top:.5em; text-align:center; }
    code { font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace; font-size:.88em;
      background:var(--accent-soft); border-radius:5px; padding:.1em .4em; }
    pre { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
      padding:1em 1.1em; overflow-x:auto; } pre code { background:none; padding:0; }
    table { width:100%; border-collapse:collapse; font-size:var(--fs-sm); }
    th,td { text-align:left; padding:.6em .7em; border-bottom:1px solid var(--border); }
    thead th { border-bottom:2px solid var(--accent-line); font-family:var(--font-head); }
    tbody tr:nth-child(even) { background:var(--accent-soft); }

    .btn { display:inline-block; background:var(--accent); color:var(--accent-fg); text-decoration:none;
      font-weight:640; border-radius:var(--radius); padding:.7em 1.35em; line-height:1.2;
      box-shadow:var(--shadow); transition:transform .15s, filter .15s; }
    .btn:hover { filter:brightness(1.06); transform:translateY(-1px); }
    .card { background:var(--surface); border:1px solid var(--border); border-radius:calc(var(--radius) + 2px);
      padding:1.25rem; box-shadow:var(--shadow); transition:transform .15s, box-shadow .15s; }
    a.card,.card a { text-decoration:none; color:inherit; } a.card:hover { transform:translateY(-2px); }
    .wide { max-width:var(--wide); }

    footer { max-width:var(--wide); border-top:1px solid var(--border); margin-top:var(--sp-16);
      padding-top:1.4rem; padding-bottom:2.6rem; font-size:var(--fs-sm); color:var(--muted); }
    footer nav { display:flex; flex-wrap:wrap; gap:.4rem 1.1rem; margin-bottom:.7rem; }
    footer nav a { color:var(--muted); text-decoration:none; } footer nav a:hover { color:var(--fg); }

    :focus-visible { outline:2px solid var(--accent); outline-offset:2px; border-radius:2px; }
    @media (prefers-reduced-motion:reduce) { *,*::before,*::after { transition:none !important; animation:none !important; }
      .btn:hover,.card:hover,a.card:hover { transform:none; } }
  `} />
</head>
<body>
  <header style="display:flex;justify-content:space-between;align-items:center">
    <a class="brand" href="/">{config.name}</a>
    {config.kind === "ecommerce" && (
      <nav style="font-size:0.95rem;display:flex;gap:1rem">
        <a href="/shop/" style="text-decoration:none">Shop</a>
        <a href="/cart/" style="text-decoration:none">Cart</a>
      </nav>
    )}
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <nav>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/terms/">Terms of Service</a>
      <a href="/disclosure/">Affiliate Disclosure</a>
      <a href="/cookies/">Cookie Policy</a>
      <a href="/editorial/">Editorial Policy</a>
    </nav>
    <p>© {year} {config.name}. All rights reserved.</p>
  </footer>
</body>
</html>
