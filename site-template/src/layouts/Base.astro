---
// Base layout — zero client JS (P1), system font stack (P4), critical CSS
// inlined by Astro (P5), semantic HTML + JSON-LD (K8/AEO).
import { loadConfig, canonicalHost } from "../lib/cms"

interface Props {
  title: string
  description: string
  path: string             // e.g. "/posts/my-post/"
  schema?: object | null   // page-specific JSON-LD
  ogType?: string          // "website" | "article" | "product"
  ogImage?: string | null  // absolute URL of the social image
}

const { title, description, path, schema = null, ogType = "website", ogImage = null } = Astro.props
const config = loadConfig()
const host = canonicalHost(config)
const canonical = `https://${host}${path}`
const year = new Date().getFullYear()
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={config.name} href="/rss.xml" />

  {/* Favicon + PWA manifest (SEO file set, amendment 3). SVG favicon covers
      modern browsers; genesis adds branded .ico/apple-touch PNGs per niche. */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0a6152" />

  {/* Open Graph + Twitter (social + AI-answer surfaces). */}
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={config.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <style>
    /* System font stack — no webfont requests (P4). Total CSS budget < 20KB (P5). */
    :root { --fg:#1a1a1a; --muted:#555; --bg:#ffffff; --accent:#0a6152; --maxw:44rem; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
           color:var(--fg); background:var(--bg); line-height:1.65; }
    header, main, footer { max-width:var(--maxw); margin:0 auto; padding:0 1.25rem; }
    header { padding-top:1.5rem; padding-bottom:1rem; }
    header a.brand { font-weight:800; font-size:1.15rem; color:var(--fg); text-decoration:none; letter-spacing:-0.02em; }
    main { padding-bottom:3rem; }
    a { color:var(--accent); }
    img { max-width:100%; height:auto; }
    footer { border-top:1px solid #e5e5e5; padding-top:1.25rem; padding-bottom:2.5rem;
             font-size:0.85rem; color:var(--muted); }
    footer nav { display:flex; flex-wrap:wrap; gap:0.9rem; margin-bottom:0.75rem; }
    footer nav a { color:var(--muted); text-decoration:none; }
    h1 { font-size:1.9rem; letter-spacing:-0.02em; line-height:1.25; }
  </style>
</head>
<body>
  <header style="display:flex;justify-content:space-between;align-items:center">
    <a class="brand" href="/">{config.name}</a>
    {config.kind === "ecommerce" && (
      <nav style="font-size:0.95rem;display:flex;gap:1rem">
        <a href="/shop/" style="text-decoration:none">Shop</a>
        <a href="/cart/" style="text-decoration:none">Cart</a>
      </nav>
    )}
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <nav>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/terms/">Terms of Service</a>
      <a href="/disclosure/">Affiliate Disclosure</a>
      <a href="/cookies/">Cookie Policy</a>
      <a href="/editorial/">Editorial Policy</a>
    </nav>
    <p>© {year} {config.name}. All rights reserved.</p>
  </footer>
</body>
</html>
