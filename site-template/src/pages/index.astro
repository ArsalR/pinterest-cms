---
import Base from "../layouts/Base.astro"
import { loadConfig, fetchAllPosts, canonicalHost } from "../lib/cms"

const config = loadConfig()
const posts = await fetchAllPosts(config)
const host = canonicalHost(config)

// Homepage layout variant (V1.1) — static, zero-JS. "magazine" is a card grid;
// "classic" (default) is the single-column list. Selected at genesis.
const layout = config.layout === "magazine" ? "magazine" : "classic"

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: config.name,
  url: `https://${host}/`,
  description: config.niche,
}
---
<Base title={config.name} description={config.niche} path="/" schema={schema}>
  <h1>{config.name}</h1>
  <p style="color:var(--muted)">{config.niche}</p>

  {layout === "magazine" ? (
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1.1rem;margin-top:1.5rem">
      {posts.map((p) => (
        <a href={`/posts/${p.slug}/`} style="display:block;text-decoration:none;color:inherit;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem">
          <span style="font-family:var(--font-head);font-weight:700;font-size:1.05rem;display:block;line-height:1.3">{p.title}</span>
          {p.excerpt && <span style="display:block;margin-top:0.4rem;color:var(--muted);font-size:0.92rem">{p.excerpt}</span>}
        </a>
      ))}
    </div>
  ) : (
    <ul style="list-style:none;padding:0">
      {posts.map((p) => (
        <li style="margin:0 0 1.4rem">
          <a href={`/posts/${p.slug}/`} style="font-weight:700;font-size:1.1rem;text-decoration:none">{p.title}</a>
          {p.excerpt && <p style="margin:0.25rem 0 0;color:var(--muted)">{p.excerpt}</p>}
        </li>
      ))}
    </ul>
  )}
  {posts.length === 0 && <p>First articles are on their way.</p>}
</Base>
