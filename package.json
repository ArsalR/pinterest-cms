{
  "name": "pinterest-cms",
  "version": "1.0.0",
  "description": "Multi-tenant Pinterest-style CMS on Cloudflare Workers + Turso + R2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:structure": "madge --circular --extensions ts src/ && node scripts/check-module-boundaries.mjs",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "madge": "^8.0.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.90.0"
  }
}
